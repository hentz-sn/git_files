#Collect user preferences
# Length
# Include uppercase letters
# Include numbers
# Include special characters

# Create all available characters
# randomly pick characters from the available characters up to the length
# ensure at least one character from each selected category is included
# ensure length is valid with preferences

import random
import string

def generate_password():
    length = int(input("Enter the desired password length: ").strip())
    include_uppercase = input("Include uppercase letters? (yes/no): ").lower().strip()
    include_numbers = input("Include numbers? (yes/no): ").lower().strip()
    include_special = input("Include special characters? (yes/no): ").lower().strip()

    if length < 4:
        print("Password length must be at least 4 characters.")
        return

    lower = string.ascii_lowercase
    upper = string.ascii_uppercase if include_uppercase == "yes" else ""
    numbers = string.digits if include_numbers == "yes" else ""
    special = string.punctuation if include_special == "yes" else ""

    all_characters = lower + upper + numbers + special

    required_characters = []
    if include_uppercase == "yes":
        required_characters.append(random.choice(upper))
    if include_numbers == "yes":
        required_characters.append(random.choice(numbers))
    if include_special == "yes":
        required_characters.append(random.choice(special))

    remaining_length = length - len(required_characters)
    password_characters = required_characters + random.choices(all_characters, k=remaining_length)
    random.shuffle(password_characters)
    password = "".join(password_characters)
    print("Generated password:", password)

generate_password()